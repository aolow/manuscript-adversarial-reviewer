{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manuscript Comparison 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "old_run_id",
    "new_run_id",
    "old_document_hashes",
    "new_document_hashes",
    "substantive_changes",
    "claims_strengthened",
    "claims_weakened",
    "concerns_resolved",
    "reported_remediation",
    "concerns_unresolved",
    "new_concerns",
    "no_longer_detected",
    "rigor_assessment",
    "positioning_assessment",
    "limitations",
    "issue_assessments",
    "llm"
